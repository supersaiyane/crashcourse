{
  "id": "jq-yq",
  "prompt": "sre@toolbox:~/data$",
  "welcome": "Welcome to the jq/yq CLI Playground.\nType commands to parse, filter, and transform JSON and YAML data.\nType 'help' for available commands, 'scenario' for guided labs.\n",
  "scenarios": [
    {
      "id": "parse-api-response",
      "title": "Parse and Transform API Response",
      "steps": [
        {
          "instruction": "First, look at the raw API response to understand the data structure.",
          "expect": "cat users.json | jq '.'",
          "hint": "Try: cat users.json | jq '.'"
        },
        {
          "instruction": "Extract just the array of users from the response envelope.",
          "expect": "cat users.json | jq '.data.users'",
          "hint": "Try: cat users.json | jq '.data.users'"
        },
        {
          "instruction": "Get only the names of all users.",
          "expect": "cat users.json | jq '.data.users[] | .name'",
          "hint": "Try: cat users.json | jq '.data.users[] | .name'"
        },
        {
          "instruction": "Filter to show only active users.",
          "expect": "cat users.json | jq '.data.users[] | select(.status == \"active\")'",
          "hint": "Try: cat users.json | jq '.data.users[] | select(.status == \"active\")'"
        },
        {
          "instruction": "Reshape the data: extract id, name, and email into a clean array of objects.",
          "expect": "cat users.json | jq '[.data.users[] | {id, name, email}]'",
          "hint": "Try: cat users.json | jq '[.data.users[] | {id, name, email}]'"
        },
        {
          "instruction": "Sort users by their created_at date, most recent first.",
          "expect": "cat users.json | jq '.data.users | sort_by(.created_at) | reverse'",
          "hint": "Try: cat users.json | jq '.data.users | sort_by(.created_at) | reverse'"
        },
        {
          "instruction": "Calculate the total spending across all users using reduce.",
          "expect": "cat users.json | jq 'reduce .data.users[] as $u (0; . + $u.spending)'",
          "hint": "Try: cat users.json | jq 'reduce .data.users[] as $u (0; . + $u.spending)'"
        },
        {
          "instruction": "Export active users as CSV (name,email) for a report.",
          "expect": "cat users.json | jq -r '.data.users[] | select(.status == \"active\") | [.name, .email] | @csv'",
          "hint": "Try: cat users.json | jq -r '.data.users[] | select(.status == \"active\") | [.name, .email] | @csv'"
        }
      ]
    },
    {
      "id": "edit-k8s-yaml",
      "title": "Edit Kubernetes YAML Configs",
      "steps": [
        {
          "instruction": "Read the current replica count from the deployment manifest.",
          "expect": "yq '.spec.replicas' deployment.yaml",
          "hint": "Try: yq '.spec.replicas' deployment.yaml"
        },
        {
          "instruction": "Check what image the container is currently using.",
          "expect": "yq '.spec.template.spec.containers[0].image' deployment.yaml",
          "hint": "Try: yq '.spec.template.spec.containers[0].image' deployment.yaml"
        },
        {
          "instruction": "Scale the deployment to 5 replicas by editing the YAML in-place.",
          "expect": "yq -i '.spec.replicas = 5' deployment.yaml",
          "hint": "Try: yq -i '.spec.replicas = 5' deployment.yaml"
        },
        {
          "instruction": "Add a new environment variable to the first container.",
          "expect": "yq -i '.spec.template.spec.containers[0].env += [{\"name\": \"LOG_LEVEL\", \"value\": \"debug\"}]' deployment.yaml",
          "hint": "Try: yq -i '.spec.template.spec.containers[0].env += [{\"name\": \"LOG_LEVEL\", \"value\": \"debug\"}]' deployment.yaml"
        },
        {
          "instruction": "Remove the annotations section from metadata.",
          "expect": "yq 'del(.metadata.annotations)' deployment.yaml",
          "hint": "Try: yq 'del(.metadata.annotations)' deployment.yaml"
        },
        {
          "instruction": "The multi-doc file has multiple resources. Extract only the Service.",
          "expect": "yq eval-all 'select(.kind == \"Service\")' multi.yaml",
          "hint": "Try: yq eval-all 'select(.kind == \"Service\")' multi.yaml"
        },
        {
          "instruction": "Merge the override values into the base configuration.",
          "expect": "yq '. * load(\"override.yaml\")' base.yaml",
          "hint": "Try: yq '. * load(\"override.yaml\")' base.yaml"
        },
        {
          "instruction": "Verify the final merged config has the correct image tag.",
          "expect": "yq '.spec.template.spec.containers[0].image' deployment.yaml",
          "hint": "Try: yq '.spec.template.spec.containers[0].image' deployment.yaml"
        }
      ]
    }
  ],
  "commands": {
    "help": "Available commands:\n  jq '.'                         — Pretty-print JSON\n  jq '.field'                    — Extract a field\n  jq '.array[]'                  — Iterate array elements\n  jq 'select(expr)'             — Filter by condition\n  jq 'map(expr)'                — Transform each element\n  jq 'sort_by(field)'           — Sort array\n  jq 'group_by(field)'          — Group array\n  jq '@csv / @tsv'              — Format as CSV/TSV\n  jq 'reduce'                   — Accumulate values\n  yq '.path' file.yaml          — Read YAML field\n  yq -i '.path = val' file      — Edit YAML in-place\n  yq eval-all 'expr' file       — Process multi-doc YAML\n\n  scenario                       — Start a guided lab\n  clear                          — Clear the terminal\n  help                           — Show this help",
