  "reference": [
    {
      "group": "jq Basics",
      "commands": [
        {
          "cmd": "cat users.json | jq '.'",
          "desc": "pretty-print JSON"
        },
        {
          "cmd": "cat users.json | jq '.data.users'",
          "desc": "extract nested field"
        },
        {
          "cmd": "cat users.json | jq '.data.users[]'",
          "desc": "iterate array"
        },
        {
          "cmd": "cat users.json | jq '.data.users[0]'",
          "desc": "first element"
        },
        {
          "cmd": "cat users.json | jq '.data.users[0] | keys'",
          "desc": "list keys"
        },
        {
          "cmd": "cat users.json | jq '.data.users | length'",
          "desc": "count elements"
        },
        {
          "cmd": "cat users.json | jq '.data.users | type'",
          "desc": "check type"
        }
      ]
    },
    {
      "group": "jq Filters & Select",
      "commands": [
        {
          "cmd": "cat users.json | jq '.data.users[] | select(.status == \"active\")'",
          "desc": "filter by value"
        },
        {
          "cmd": "cat users.json | jq '.data.users[] | select(.spending > 3000)'",
          "desc": "numeric filter"
        },
        {
          "cmd": "cat users.json | jq '.data.users[] | select(.role == \"sre\")'",
          "desc": "filter by role"
        },
        {
          "cmd": "cat users.json | jq '.data.users[] | if .status == \"active\" then .name else empty end'",
          "desc": "conditional"
        },
        {
          "cmd": "cat users.json | jq --arg role \"sre\" '.data.users[] | select(.role == $role)'",
          "desc": "variable binding"
        }
      ]
    },
    {
      "group": "jq Transform & Reshape",
      "commands": [
        {
          "cmd": "cat users.json | jq '[.data.users[] | {id, name, email}]'",
          "desc": "reshape objects"
        },
        {
          "cmd": "cat users.json | jq '.data.users | map(.name)'",
          "desc": "map to field"
        },
        {
          "cmd": "cat users.json | jq '.data.users | sort_by(.created_at) | reverse'",
          "desc": "sort descending"
        },
        {
          "cmd": "cat users.json | jq '.data.users | group_by(.role)'",
          "desc": "group by field"
        },
        {
          "cmd": "cat users.json | jq '.data.users | unique_by(.role) | .[].role'",
          "desc": "unique values"
        },
        {
          "cmd": "cat users.json | jq '.data.users[0] | to_entries'",
          "desc": "object to pairs"
        }
      ]
    },
    {
      "group": "jq Output Formats",
      "commands": [
        {
          "cmd": "cat users.json | jq -r '.data.users[] | [.name, .email] | @csv'",
          "desc": "export as CSV"
        },
        {
          "cmd": "cat users.json | jq -r '.data.users[] | [.name, .email] | @tsv'",
          "desc": "export as TSV"
        },
        {
          "cmd": "cat users.json | jq -r '.data.users[0].email | @base64'",
          "desc": "base64 encode"
        },
        {
          "cmd": "cat users.json | jq 'reduce .data.users[] as $u (0; . + $u.spending)'",
          "desc": "sum values"
        }
      ]
    },
    {
      "group": "jq Real-World (AWS/K8s)",
      "commands": [
        {
          "cmd": "cat instances.json | jq '.Reservations[].Instances[] | {id: .InstanceId, type: .InstanceType, state: .State.Name}'",
          "desc": "AWS instances"
        },
        {
          "cmd": "cat instances.json | jq '.Reservations[].Instances[] | select(.State.Name == \"running\") | .InstanceId'",
          "desc": "running IDs"
        },
        {
          "cmd": "cat pods.json | jq '.items[] | {name: .metadata.name, status: .status.phase}'",
          "desc": "K8s pod status"
        },
        {
          "cmd": "cat package.json | jq '.dependencies | keys'",
          "desc": "list deps"
        }
      ]
    },
    {
      "group": "yq Read & Query",
      "commands": [
        {
          "cmd": "yq '.metadata.name' deployment.yaml",
          "desc": "read field"
        },
        {
          "cmd": "yq '.spec.replicas' deployment.yaml",
          "desc": "read replicas"
        },
        {
          "cmd": "yq '.spec.template.spec.containers[0].image' deployment.yaml",
          "desc": "container image"
        },
        {
          "cmd": "yq '.spec.template.spec.containers[0].env' deployment.yaml",
          "desc": "env vars"
        },
        {
          "cmd": "yq -o=json '.' deployment.yaml",
          "desc": "YAML to JSON"
        },
        {
          "cmd": "yq -P '.' config.json",
          "desc": "JSON to YAML"
        }
      ]
    },
    {
      "group": "yq Edit & Merge",
      "commands": [
        {
          "cmd": "yq -i '.spec.replicas = 5' deployment.yaml",
          "desc": "set value"
        },
        {
          "cmd": "yq -i '.spec.template.spec.containers[0].env += [{\"name\": \"LOG_LEVEL\", \"value\": \"debug\"}]' deployment.yaml",
          "desc": "add env var"
        },
        {
          "cmd": "yq 'del(.metadata.annotations)' deployment.yaml",
          "desc": "delete field"
        },
        {
          "cmd": "yq eval-all 'select(.kind == \"Service\")' multi.yaml",
          "desc": "filter multi-doc"
        },
        {
          "cmd": "yq '. * load(\"override.yaml\")' base.yaml",
          "desc": "merge files"
        },
        {
          "cmd": "yq ea '. as $item ireduce ({}; . * $item)' base.yaml override.yaml",
          "desc": "deep merge"
        }
      ]
    },
    {
      "group": "Scenarios",
      "commands": [
        {
          "cmd": "scenario parse-api-response",
          "desc": "parse & transform JSON"
        },
        {
          "cmd": "scenario edit-k8s-yaml",
          "desc": "edit K8s YAML configs"
        }
      ]
    }
  ]
}
