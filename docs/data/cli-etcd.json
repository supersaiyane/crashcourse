{
  "id": "etcd",
  "prompt": "etcd@cluster:~$",
  "welcome": "Welcome to the etcd CLI Playground.\nType commands to explore a simulated 3-node etcd cluster.\nType 'help' for available commands, 'scenario' for guided labs.\n",
  "scenarios": [
    {
      "id": "backup-and-restore",
      "title": "Backup and Restore etcd",
      "steps": [
        {
          "instruction": "First, check the health of all cluster endpoints before taking a backup.",
          "expect": "etcdctl endpoint health --cluster",
          "hint": "Try: etcdctl endpoint health --cluster"
        },
        {
          "instruction": "Good, all nodes are healthy. Check the current endpoint status to see who is the leader.",
          "expect": "etcdctl endpoint status --cluster -w table",
          "hint": "Try: etcdctl endpoint status --cluster -w table"
        },
        {
          "instruction": "Node etcd-1 is the leader. Now take a snapshot backup of the cluster.",
          "expect": "etcdctl snapshot save /backup/etcd-snapshot-2026-06-02.db",
          "hint": "Try: etcdctl snapshot save /backup/etcd-snapshot-2026-06-02.db"
        },
        {
          "instruction": "Verify the snapshot is valid by checking its status.",
          "expect": "etcdctl snapshot status /backup/etcd-snapshot-2026-06-02.db -w table",
          "hint": "Try: etcdctl snapshot status /backup/etcd-snapshot-2026-06-02.db -w table"
        },
        {
          "instruction": "The snapshot has 847 keys and looks good. Now simulate a disaster — someone deleted critical keys. List keys under /config/ to see the damage.",
          "expect": "etcdctl get /config/ --prefix",
          "hint": "Try: etcdctl get /config/ --prefix"
        },
        {
          "instruction": "The /config/ prefix is empty — data is lost. Restore from the snapshot to a new data directory.",
          "expect": "etcdctl snapshot restore /backup/etcd-snapshot-2026-06-02.db --data-dir /var/lib/etcd-restored",
          "hint": "Try: etcdctl snapshot restore /backup/etcd-snapshot-2026-06-02.db --data-dir /var/lib/etcd-restored"
        },
        {
          "instruction": "Restore complete. Verify the cluster is healthy again after pointing etcd to the restored data directory.",
          "expect": "etcdctl endpoint health --cluster",
          "hint": "Try: etcdctl endpoint health --cluster"
        },
        {
          "instruction": "All healthy. Confirm the /config/ keys are back by reading one.",
          "expect": "etcdctl get /config/database/host",
          "hint": "Try: etcdctl get /config/database/host"
        }
      ]
    },
    {
      "id": "debug-cluster-health",
      "title": "Debug Cluster Health Issues",
      "steps": [
        {
          "instruction": "Users report slow API responses. Start by checking the health of all etcd endpoints.",
          "expect": "etcdctl endpoint health --cluster",
          "hint": "Try: etcdctl endpoint health --cluster"
        },
        {
          "instruction": "Node etcd-3 is unhealthy. Check the detailed status of all endpoints to see resource usage.",
          "expect": "etcdctl endpoint status --cluster -w table",
          "hint": "Try: etcdctl endpoint status --cluster -w table"
        },
        {
          "instruction": "etcd-3 has a very large DB size (6.2 GB) compared to the others. Check if there are any active alarms.",
          "expect": "etcdctl alarm list",
          "hint": "Try: etcdctl alarm list"
        },
        {
          "instruction": "There is a NOSPACE alarm on etcd-3. The DB has grown too large. First, compact the revision history to free up space.",
          "expect": "etcdctl compact 1250000",
          "hint": "Try: etcdctl compact 1250000"
        },
        {
          "instruction": "History compacted. Now defragment each member to reclaim disk space.",
          "expect": "etcdctl defrag --cluster",
          "hint": "Try: etcdctl defrag --cluster"
        },
        {
          "instruction": "Defragmentation complete. Disarm the NOSPACE alarm so the cluster accepts writes again.",
          "expect": "etcdctl alarm disarm",
          "hint": "Try: etcdctl alarm disarm"
        },
        {
          "instruction": "Good, alarm cleared. Verify the cluster is healthy again and all members are in sync.",
          "expect": "etcdctl endpoint status --cluster -w table",
          "hint": "Try: etcdctl endpoint status --cluster -w table"
        },
        {
          "instruction": "DB sizes are back to normal. Confirm writes are working by putting a test key.",
          "expect": "etcdctl put /health-check/test ok",
          "hint": "Try: etcdctl put /health-check/test ok"
        }
      ]
    }
  ],
  "commands": {
    "help": "Available commands:\n  etcdctl put <key> <value>      — Write a key-value pair\n  etcdctl get <key>              — Read a key (--prefix for range, --keys-only, -w table)\n  etcdctl del <key>              — Delete a key (--prefix for range)\n  etcdctl watch <key>            — Watch for changes (--prefix for range)\n  etcdctl txn                    — Execute a transaction\n  etcdctl member list            — List cluster members\n  etcdctl member add             — Add a new member\n  etcdctl member remove          — Remove a member\n  etcdctl endpoint status        — Show endpoint status (--cluster, -w table)\n  etcdctl endpoint health        — Check endpoint health (--cluster)\n  etcdctl snapshot save          — Save a snapshot backup\n  etcdctl snapshot restore       — Restore from snapshot\n  etcdctl snapshot status        — Show snapshot details\n  etcdctl alarm list             — List active alarms\n  etcdctl alarm disarm           — Clear all alarms\n  etcdctl compact <rev>          — Compact revision history\n  etcdctl defrag                 — Defragment storage (--cluster)\n  etcdctl lease grant <ttl>      — Create a lease with TTL\n  etcdctl lease revoke <id>      — Revoke a lease\n  etcdctl lease list             — List active leases\n  etcdctl lease timetolive <id>  — Check remaining TTL\n  etcdctl auth enable            — Enable authentication\n  etcdctl user add               — Add a user\n  etcdctl user list              — List users\n  etcdctl user get               — Get user details\n  etcdctl user delete            — Delete a user\n  etcdctl role add               — Add a role\n  etcdctl role list              — List roles\n  etcdctl role get               — Get role details\n  etcdctl role grant-permission  — Grant key permission to role\n  etcdctl user grant-role        — Assign role to user\n  etcdctl version                — Show etcdctl version\n\n  scenario                       — Start a guided lab\n  clear                          — Clear the terminal\n  help                           — Show this help",
