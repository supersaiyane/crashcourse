{
  "id": "aws",
  "prompt": "aws@infra:~$",
  "welcome": "Welcome to the AWS CLI Playground.\nType commands to explore a simulated BFSI production account (ap-south-1).\nType 'help' for available commands, 'scenario' for guided labs.\n",
  "scenarios": [
    {
      "id": "investigate-ec2-issue",
      "title": "Investigate a Production EC2 Issue",
      "steps": [
        {
          "instruction": "First, confirm your identity and which account you are operating in.",
          "expect": "aws sts get-caller-identity",
          "hint": "Try: aws sts get-caller-identity"
        },
        {
          "instruction": "A critical payment-processing instance is reported unhealthy. List all running EC2 instances.",
          "expect": "aws ec2 describe-instances",
          "hint": "Try: aws ec2 describe-instances"
        },
        {
          "instruction": "Instance i-0a1b2c3d4e5f67890 shows 'impaired' status. Check its detailed status.",
          "expect": "aws ec2 describe-instance-status",
          "hint": "Try: aws ec2 describe-instance-status"
        },
        {
          "instruction": "The instance has a failed system status check. Check which security group is attached to understand network access.",
          "expect": "aws ec2 describe-security-groups",
          "hint": "Try: aws ec2 describe-security-groups"
        },
        {
          "instruction": "Check the VPC configuration to understand the network topology.",
          "expect": "aws ec2 describe-vpcs",
          "hint": "Try: aws ec2 describe-vpcs"
        },
        {
          "instruction": "Look at the subnets to verify the instance is in the correct availability zone.",
          "expect": "aws ec2 describe-subnets",
          "hint": "Try: aws ec2 describe-subnets"
        },
        {
          "instruction": "Check CloudWatch log groups for application logs from this instance.",
          "expect": "aws logs describe-log-groups",
          "hint": "Try: aws logs describe-log-groups"
        },
        {
          "instruction": "Filter the application logs for recent errors on the payment service.",
          "expect": "aws logs filter-log-events --log-group-name /aws/ec2/payment-service",
          "hint": "Try: aws logs filter-log-events --log-group-name /aws/ec2/payment-service"
        }
      ]
    },
    {
      "id": "deploy-secure-s3",
      "title": "Deploy and Secure an S3 Bucket",
      "steps": [
        {
          "instruction": "List existing S3 buckets to check naming conventions.",
          "expect": "aws s3 ls",
          "hint": "Try: aws s3 ls"
        },
        {
          "instruction": "Create a new bucket for storing audit logs (BFSI compliance requirement).",
          "expect": "aws s3 mb s3://bfsi-prod-audit-logs-2026",
          "hint": "Try: aws s3 mb s3://bfsi-prod-audit-logs-2026"
        },
        {
          "instruction": "Enable versioning on the bucket to protect against accidental deletion.",
          "expect": "aws s3api get-bucket-versioning --bucket bfsi-prod-audit-logs-2026",
          "hint": "Try: aws s3api get-bucket-versioning --bucket bfsi-prod-audit-logs-2026"
        },
        {
          "instruction": "Apply a bucket policy to restrict access to the security team role only.",
          "expect": "aws s3api put-bucket-policy --bucket bfsi-prod-audit-logs-2026",
          "hint": "Try: aws s3api put-bucket-policy --bucket bfsi-prod-audit-logs-2026"
        },
        {
          "instruction": "Configure lifecycle rules to transition old logs to Glacier after 90 days.",
          "expect": "aws s3api put-lifecycle-configuration --bucket bfsi-prod-audit-logs-2026",
          "hint": "Try: aws s3api put-lifecycle-configuration --bucket bfsi-prod-audit-logs-2026"
        },
        {
          "instruction": "Upload a sample audit file to verify write access.",
          "expect": "aws s3 cp audit-report.csv s3://bfsi-prod-audit-logs-2026/2026/06/",
          "hint": "Try: aws s3 cp audit-report.csv s3://bfsi-prod-audit-logs-2026/2026/06/"
        },
        {
          "instruction": "Sync the local audit directory to S3 for bulk upload.",
          "expect": "aws s3 sync ./audit-logs s3://bfsi-prod-audit-logs-2026/2026/06/",
          "hint": "Try: aws s3 sync ./audit-logs s3://bfsi-prod-audit-logs-2026/2026/06/"
        },
        {
          "instruction": "Verify the bucket contents after upload.",
          "expect": "aws s3 ls s3://bfsi-prod-audit-logs-2026/2026/06/",
          "hint": "Try: aws s3 ls s3://bfsi-prod-audit-logs-2026/2026/06/"
        }
      ]
    }
  ],
  "commands": {
    "help": "Available commands:\n  aws sts get-caller-identity     \u2014 Show current IAM identity\n  aws configure list              \u2014 Show current CLI configuration\n  aws ec2 describe-instances      \u2014 List EC2 instances\n  aws ec2 describe-instance-status \u2014 Instance health checks\n  aws ec2 describe-security-groups \u2014 List security groups\n  aws ec2 describe-vpcs           \u2014 List VPCs\n  aws ec2 describe-subnets        \u2014 List subnets\n  aws ec2 start-instances         \u2014 Start an instance\n  aws ec2 stop-instances          \u2014 Stop an instance\n  aws s3 ls                       \u2014 List S3 buckets/objects\n  aws s3 cp                       \u2014 Copy files to/from S3\n  aws s3 sync                     \u2014 Sync directories with S3\n  aws s3 mb                       \u2014 Create a bucket\n  aws s3api put-bucket-policy     \u2014 Set bucket policy\n  aws s3api get-bucket-versioning \u2014 Check versioning status\n  aws s3api put-lifecycle-configuration \u2014 Set lifecycle rules\n  aws iam list-users              \u2014 List IAM users\n  aws iam list-roles              \u2014 List IAM roles\n  aws iam get-role                \u2014 Get role details\n  aws iam get-user                \u2014 Get user details\n  aws iam list-attached-role-policies \u2014 Role policy attachments\n  aws logs describe-log-groups    \u2014 List CloudWatch log groups\n  aws logs filter-log-events      \u2014 Search log events\n  aws cloudwatch get-metric-statistics \u2014 Get CloudWatch metrics\n  aws eks list-clusters           \u2014 List EKS clusters\n  aws eks describe-cluster        \u2014 EKS cluster details\n  aws eks update-kubeconfig       \u2014 Configure kubectl\n  aws rds describe-db-instances   \u2014 List RDS instances\n  aws rds describe-db-clusters    \u2014 List RDS clusters\n\n  scenario                        \u2014 Start a guided lab\n  clear                           \u2014 Clear the terminal\n  help                            \u2014 Show this help",
